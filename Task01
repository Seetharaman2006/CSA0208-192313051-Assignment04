#include <stdio.h>

int main() {
    float price = 100.0;
    int qty = 2;
    int senior = 1; /* 1 if senior citizen, 0 otherwise */
    
    /* Decoupled calculation using intermediate variables */
    float gross = price * qty;
    float discount = senior ? (gross * 15.0 / 100.0) : 0.0;
    float tax = gross * 5.0 / 100.0;
    
    float total = gross - discount + tax;
    
    /* Apply Rs 50 off if total is above Rs 1000 */
    float net = (total > 1000.0) ? (total - 50.0) : total;
    
    printf("Total: %.2f\nNet: %.2f\n", total, net);
    
    return 0;
}
